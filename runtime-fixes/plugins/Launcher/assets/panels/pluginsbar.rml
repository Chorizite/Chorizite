<rml>
  <head>
    <title>Plugins</title>
    <style>
      body {
        font-size: 14dp;
        font-family: LatoLatin;
        color: #fff;
        z-index: 5000;
      }

      #handle {
        width: 24dp;
        height: 24dp;
        decorator: image(icon-move);
        background-color: #111111;
        cursor: 0x06006119 14 14;
      }

      .panel {
        padding: 4dp;
      }

      .panel-inner {
        display: flex;
        padding: 1dp 1dp 0 1dp;
        background-color: #111;
      }

      .game-icons {
        display: flex;
        overflow: hidden;
        height: 25dp;
      }

      .plugin-icons {
        display: flex;
      }

      .plugin-icons > div {
        decorator: image(icon-slot-bg);
      }

      .plugin-icons button.icon {
        height: 24dp;
        width: 24dp;
        padding: 0;
        margin: 0;
        color: #aaa;
        position: relative;
        display: block;
        decorator: none;
      }

      .plugin-icons button.icon.visible {
        color: #fff;
        font-weight: bold;
      }

      .plugin-icons button.icon .overlay {
        height: 24dp;
        width: 24dp;
        line-height: 24dp;
      }

      .plugin-icons button.icon.visible .overlay {
        decorator: image(icon-border-thick);
      }

      button.icon {
        height: 24dp;
        width: 24dp;
        margin: 0;
        padding: 0;
      }

      .hidden {
        display: none;
      }
    </style>
    <script src="pluginsbar.lua"></script>
  </head>
  <body>
    <div id="pluginsbar-wrapper"></div>
  </body>
</rml>
